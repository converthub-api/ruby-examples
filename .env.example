# ConvertHub API Configuration
# Copy this file to .env and fill in your actual values

# Your API key from https://converthub.com/api
CONVERTHUB_API_KEY="your_api_key_here"

# API base URL (default: https://api.converthub.com/v2)
CONVERTHUB_API_BASE_URL=https://api.converthub.com/v2

# Webhook secret for signature verification (optional)
WEBHOOK_SECRET=your_webhook_secret_here
